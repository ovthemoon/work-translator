# LLM (Upstage Solar, OpenAI 호환)
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro4
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
# OpenRouter 를 거칠 때: UPSTAGE_API_KEY=<OpenRouter 키>, UPSTAGE_BASE_URL=https://openrouter.ai/api/v1, UPSTAGE_MODEL=upstage/solar-pro4
# none | minimal | low | medium | high  (속도 우선: none)
UPSTAGE_REASONING_EFFORT=none

# 서비스 URL (공유 카드에 표시)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 피드백 저장 (동의한 경우에만). 비워두면 저장 기능 비활성화
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 레이트 리밋 + 캐시. 비워두면 메모리 기반으로 대체(개발용)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 개발 전용: mock 이면 실제 모델 대신 예시 응답 (프로덕션에서는 무시됨)
LLM_PROVIDER=

# 평가 스크립트가 한도·캐시를 건너뛰는 비밀 토큰 (비워두면 우회 불가)
EVAL_BYPASS_TOKEN=

# 배포 프록시와 앱에 같은 값을 별도로 등록합니다. 실제 값은 저장소에 넣지 않습니다.
PROXY_SECRET=
